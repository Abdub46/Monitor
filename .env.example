# MongoDB
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/monitoring-platform

# NextAuth
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=replace-with-a-long-random-string

# Cron protection - used to verify requests to /api/monitor/check
CRON_SECRET=replace-with-a-long-random-string

# AI Root Cause Analysis
OPENAI_API_KEY=sk-replace-me
OPENAI_MODEL=gpt-4o-mini

# Email notifications (SMTP - e.g. Gmail app password, SendGrid, Mailgun, etc.)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=replace-me
SMTP_PASSWORD=replace-me
SMTP_FROM="Monitoring Platform <alerts@example.com>"

# Telegram Bot (create via @BotFather, get token; each user adds their own chat ID in Settings)
TELEGRAM_BOT_TOKEN=replace-me

# Firebase Push Notifications - OPTIONAL for Phase 2.
# Leave blank to skip push; Email + Telegram work independently.
# Client-side config (from Firebase console -> Project settings -> General)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_VAPID_KEY=
# Server-side service account (Firebase console -> Project settings -> Service accounts -> Generate key)
FIREBASE_SERVICE_ACCOUNT_JSON=
